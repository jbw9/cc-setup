{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "autoCompactEnabled": true,
  "autoCompactWindow": 400000,
  "tui": "fullscreen",
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run:*)",
      "Bash(yarn test:*)",
      "Bash(bun test:*)",
      "Bash(bun run:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(cargo test:*)",
      "Bash(cargo check:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make:*)",
      "Bash(tsc:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
